# Optional overrides for `npm run build:ios` (apps/ios/scripts/build.mjs), set in the environment:
# this repository's PC backup server (server/backups.mjs) and its key.
VITE_READER_BACKUP_URL=https://192.168.1.197:7722
# If empty, the build reads ~/.local/share/gallery-reader/backups/access-key, created by the server.
# Built app bundles contain this private key. Do not publish them.
VITE_READER_BACKUP_KEY=
